# =============================================================================
# The entries that actually matter for THIS repo are at the top. Everything
# below is conventional coverage.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
# This project has no .env by design: all live values are Terraform outputs, read
# on demand via `terraform output`, so there is no static file to leak or to go
# stale. These patterns stay as a guard in case anyone adds one.
#
# The negations must come AFTER the patterns that catch them, and they keep
# templates like terraform.tfvars.example committed.
.env
.env.*
*.env
!*.example
!*.example.*

# Holds the SP secret when testing locally - never commit this.
function/local.settings.json

# Generic credential files.
secrets.*
credentials.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*_rsa
*_ed25519
.netrc
.pgpass
.htpasswd

# --- Terraform ---------------------------------------------------------------
# State contains live secrets in plaintext: the storage account access key, the
# Function host key, and the APIM subscription key.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Saved plans embed a full copy of state, so they leak the same credentials.
# Verified: 7 of the 9 plan files in this repo contained the live storage key.
# Delete them once applied rather than keeping them around.
*.tfplan
*.tfplan.*
*.plan

# Variable files carry real values (SSH public keys, source CIDRs, client ids).
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!terraform.tfvars.example
!*.tfvars.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.tfstate.lock.info

